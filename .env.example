# Archivo de ejemplo para variables de entorno
# Copia este archivo a .env y completa los valores necesarios

# LinkedIn API (opcional)
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here
LINKEDIN_ACCESS_TOKEN=your_access_token_here

# Upwork API (opcional)
UPWORK_API_KEY=your_api_key_here
UPWORK_API_SECRET=your_api_secret_here

# Credenciales para sitios que requieren login (opcional)
# Solo necesario si quieres acceder a ofertas que requieren autenticación
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password_here

# Configuración de proxy (opcional)
# Útil si necesitas rotar IPs para evitar bloqueos
USE_PROXY=false
PROXY_URL=http://your-proxy:port
PROXY_USERNAME=
PROXY_PASSWORD=

# Configuración de base de datos (opcional)
# Por defecto se usa SQLite local
DATABASE_URL=sqlite:///./data/jobs.db

# Configuración de scraping
# Sobrescribe valores del config.yaml si se definen aquí
MAX_JOBS_PER_PLATFORM=100
DELAY_BETWEEN_REQUESTS=2
HEADLESS_MODE=true

# Configuración de logs
LOG_LEVEL=INFO
